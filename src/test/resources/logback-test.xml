<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===================================================== -->
    <!-- Log levels configurables depuis Maven / JVM            -->
    <!-- ===================================================== -->
    <!--
        Valeurs possibles :
        TRACE, DEBUG, INFO, WARN, ERROR, OFF
    -->
    <property name="FRAMEWORK_LOG_LEVEL" value="${framework.log.level:-INFO}"/>
    <property name="LIBRARY_LOG_LEVEL" value="${library.log.level:-WARN}"/>
    <property name="ROOT_LOG_LEVEL" value="${root.log.level:-WARN}"/>

    <!-- ===================================================== -->
    <!-- Console appender                                      -->
    <!-- ===================================================== -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{45} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===================================================== -->
    <!-- File appender                                         -->
    <!-- ===================================================== -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/framework-test.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{80} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===================================================== -->
    <!-- Packages du framework                                 -->
    <!-- ===================================================== -->
    <logger name="hooks" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="runners" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="stepdefinitions" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="pages" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="core" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="core.heal" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="core.heal.dom" level="${FRAMEWORK_LOG_LEVEL}"/>
    <logger name="config" level="${FRAMEWORK_LOG_LEVEL}"/>

    <!-- ===================================================== -->
    <!-- Librairies externes                                   -->
    <!-- ===================================================== -->
    <logger name="com.microsoft.playwright" level="${LIBRARY_LOG_LEVEL}"/>
    <logger name="io.cucumber" level="${LIBRARY_LOG_LEVEL}"/>
    <logger name="org.junit" level="${LIBRARY_LOG_LEVEL}"/>
    <logger name="org.apache" level="${LIBRARY_LOG_LEVEL}"/>
    <logger name="com.fasterxml.jackson" level="${LIBRARY_LOG_LEVEL}"/>
    <logger name="io.qameta.allure" level="${LIBRARY_LOG_LEVEL}"/>

    <!-- ===================================================== -->
    <!-- Niveau par défaut                                     -->
    <!-- ===================================================== -->
    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>