<configuration>

    <!-- Console logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/framework-test.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logs du framework -->
    <logger name="hooks" level="INFO"/>
    <logger name="runners" level="INFO"/>
    <logger name="stepdefinitions" level="INFO"/>
    <logger name="pages" level="INFO"/>
    <logger name="core" level="INFO"/>
    <logger name="config" level="INFO"/>
    <logger name="heal" level="INFO"/>

    <!-- Niveau global -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>