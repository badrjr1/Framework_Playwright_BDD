pipeline {
    agent {
        docker {
            // Image built from Jenkinsfile/docker/Dockerfile (name example below)
            image 'framework-playwright/playwright-java-maven:latest'
            args '--shm-size=1g -v /var/jenkins_playwright_cache:/home/jenkins/.cache/ms-playwright'
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['local'],
            description: 'Environment configuration: config-local.properties'
        )

        choice(
            name: 'BROWSER',
            choices: ['chromium', 'firefox', 'webkit'],
            description: 'Browser used by Playwright'
        )

        string(
            name: 'CUCUMBER_TAGS',
            defaultValue: '@ui',
            description: 'Cucumber tags to execute. Examples: @ui, @api, @hybrid, @websocket, @ui && @smoke'
        )

        choice(
            name: 'FRAMEWORK_LOG_LEVEL',
            choices: ['DEBUG', 'INFO', 'WARN', 'ERROR'],
            description: 'Framework log level'
        )

        booleanParam(
            name: 'GENERATE_ALLURE_REPORT',
            defaultValue: true,
            description: 'Generate and publish Allure report'
        )

        booleanParam(
            name: 'RETRY_FAILED_TESTS',
            defaultValue: false,
            description: 'Retry failed tests automatically'
        )
    }

    environment {
        MAVEN_OPTS = '-Xmx2048m'
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8'
        ALLURE_RESULTS = 'target/allure-results'
        ALLURE_REPORT = 'allure-report'
        BUILD_TIMESTAMP = sh(script: 'date +%Y%m%d_%H%M%S', returnStdout: true).trim()
    }

    stages {

        stage('📋 Checkout') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '📋 Checking out source code...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }
                checkout scm
            }
        }

        stage('🔧 Prepare Workspace') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '🔧 Preparing workspace directories...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh '''
                    mkdir -p target/logs
                    mkdir -p target/videos
                    mkdir -p target/screenshots
                    mkdir -p target/allure-results
                    mkdir -p test-reports

                    echo "✅ Workspace ready"
                '''
            }
        }

        stage('✅ Verify Tools') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '✅ Verifying build environment...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh '''
                    echo "Java version:"
                    java -version

                    echo ""
                    echo "Maven version:"
                    mvn -version

                    echo ""
                    echo "Allure version:"
                    allure --version || echo "⚠️  Allure not found in PATH"
                '''
            }
        }

        stage('🔐 Install System Dependencies') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '🔐 Installing system dependencies required by Playwright...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh '''
                    # Detect package manager and install needed libs for Playwright
                    if command -v apt-get &> /dev/null; then
                        sudo apt-get update -y
                        sudo apt-get install -y \
                          libglib2.0-0 \
                          libnss3 \
                          libnspr4 \
                          libdbus-1-3 \
                          libatk1.0-0 \
                          libatk-bridge2.0-0 \
                          libcups2 \
                          libdrm2 \
                          libxcb1 \
                          libxkbcommon0 \
                          libatspi2.0-0 \
                          libx11-6 \
                          libxcomposite1 \
                          libxdamage1 \
                          libxext6 \
                          libxfixes3 \
                          libxrandr2 \
                          libgbm1 \
                          libpango-1.0-0 \
                          libcairo2 \
                          libasound2 || true
                    elif command -v yum &> /dev/null; then
                        sudo yum install -y \
                          alsa-lib \
                          atk \
                          at-spi2-atk \
                          cairo \
                          dbus-glib \
                          GConf2 \
                          glib2 \
                          gtk3 \
                          libX11 \
                          libXcomposite \
                          libXcursor \
                          libXdamage \
                          libXext \
                          libXi \
                          libXrandr \
                          libXss \
                          libXtst \
                          mesa-libgbm \
                          nss \
                          nspr || true
                    else
                        echo "No known package manager found. Trying Playwright installer (maven)..."
                        sudo mvn exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install-deps" || true
                    fi
                '''
            }
        }

        stage('🎮 Install Playwright Browsers') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo "🎮 Installing Playwright browser: ${params.BROWSER}"
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh """
                    mvn -q exec:java \
                      -Dexec.mainClass=com.microsoft.playwright.CLI \
                      -Dexec.args="install ${params.BROWSER}"

                    echo "✅ Browser ${params.BROWSER} installed"
                """
            }
        }

        stage('🧪 Run Tests') {
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo "🧪 Executing tests..."
                    echo "   Environment: ${params.ENV}"
                    echo "   Browser: ${params.BROWSER}"
                    echo "   Tags: ${params.CUCUMBER_TAGS}"
                    echo "   Log Level: ${params.FRAMEWORK_LOG_LEVEL}"
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh """
                    mvn clean test \
                      -Denv=${params.ENV} \
                      -Dbrowser.name=${params.BROWSER} \
                      -Dframework.log.level=${params.FRAMEWORK_LOG_LEVEL} \
                      -Dlibrary.log.level=WARN \
                      -Dcucumber.filter.tags="${params.CUCUMBER_TAGS}" \
                      --batch-mode \
                      --show-version \
                      -Dorg.slf4j.simpleLogger.defaultLogLevel=INFO
                """
            }
            post {
                always {
                    echo '✅ Test execution completed'
                }
                unstable {
                    echo '⚠️  Some tests failed'
                }
                failure {
                    echo '❌ Test execution failed'
                }
            }
        }

        stage('📊 Prepare Allure Report') {
            when {
                expression { params.GENERATE_ALLURE_REPORT }
            }
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '📊 Preparing Allure report with history...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh '''
                    if [ -d "${ALLURE_REPORT}/history" ]; then
                        echo "📂 Copying previous Allure history..."
                        mkdir -p "${ALLURE_RESULTS}/history"
                        cp -r "${ALLURE_REPORT}/history/"* "${ALLURE_RESULTS}/history/" || true
                    else
                        echo "ℹ️  No previous Allure history found - first run"
                    fi
                '''
            }
        }

        stage('📈 Generate Allure Report') {
            when {
                expression { params.GENERATE_ALLURE_REPORT }
            }
            steps {
                script {
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                    echo '📈 Generating Allure report...'
                    echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                }

                sh '''
                    if command -v allure &> /dev/null; then
                        allure generate "${ALLURE_RESULTS}" --clean -o "${ALLURE_REPORT}"
                        echo "✅ Allure report generated successfully"
                    else
                        echo "⚠️  Allure CLI not found - skipping report generation"
                    fi
                '''
            }
        }
    }

    post {

        always {
            script {
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                echo '📦 Publishing reports and archiving artifacts...'
                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
            }

            // Publish JUnit test results
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/**/*.xml'

            // Archive artifacts
            archiveArtifacts artifacts: '''
                target/allure-results/**,
                allure-report/**,
                target/logs/**,
                target/videos/**,
                target/screenshots/**,
                test-reports/**
            ''', allowEmptyArchive: true, fingerprint: true

            // Publish Allure report
            allure([
                includeProperties: false,
                jdk: '',
                reportBuildPolicy: 'ALWAYS',
                results: [[path: 'target/allure-results']]
            ])

            // Clean workspace
            cleanWs(
                deleteDirs: true,
                patterns: [
                    [pattern: 'target/test-classes/**', type: 'INCLUDE'],
                    [pattern: '**/node_modules/**', type: 'INCLUDE']
                ]
            )
        }

        success {
            script {
                echo '✅ Pipeline completed successfully!'
                echo "Build #${env.BUILD_NUMBER} succeeded"
            }
        }

        unstable {
            script {
                echo '⚠️  Pipeline completed with unstable test results'
                echo "Build #${env.BUILD_NUMBER} unstable"
            }
        }

        failure {
            script {
                echo '❌ Pipeline failed!'
                echo "Build #${env.BUILD_NUMBER} failed"
                echo "Please check the logs for details"
            }
        }

        cleanup {
            script {
                echo '🧹 Cleanup completed'
            }
        }
    }
}