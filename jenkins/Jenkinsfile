pipeline {
    agent any

    parameters {

        string(
            name: 'EMAIL_RECIPIENTS',
            defaultValue: '',
            description: 'Email recipients separated by comma'
        )

        choice(
            name: 'BROWSER',
            choices: ['chromium'],
            description: 'Browser used by Playwright'
        )

        choice(
            name: 'TAGS',
            choices: [
                '@ui', '@hybrid'
            ],
            description: 'Cucumber tag. Example: @ui, @api, @ws, @hybrid, @ui or @api'
        )

        choice(
            name: 'FRAMEWORK_LOG_LEVEL',
            choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
            description: 'Framework log level'
        )
    }

    options {
            timestamps()
            buildDiscarder(logRotator(numToKeepStr: '10'))
            disableConcurrentBuilds()
            timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        ALLURE_RESULTS = 'target/allure-results'
        ALLURE_REPORT = 'allure-report'
        TEST_EXIT_CODE_FILE = 'test-exit-code.txt'
        JOB_STATUS_MESSAGE = ''
        EMAIL_REPORT_FILE = 'email-report.html'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    echo "Checking Java..."
                    java -version

                    echo "Checking Maven..."
                    mvn -version

                    echo "Checking Allure CLI..."
                    allure --version || true
                '''
            }
        }

        stage('Prepare Workspace') {
            steps {
                sh '''
                    mkdir -p target/logs
                    mkdir -p target/videos
                    mkdir -p target/screenshots
                    mkdir -p target/allure-results

                    rm -f "${TEST_EXIT_CODE_FILE}"
                '''
            }
        }

        stage('Install Playwright Browser') {
            steps {
                sh """
                    mvn -q exec:java \
                      -Dexec.mainClass=com.microsoft.playwright.CLI \
                      -Dexec.args="install ${params.BROWSER}"
                """
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    def userTags = params.TAGS?.trim()
                    def finalTags = ''

                    finalTags = "(${userTags}) and not @ignore"

                    echo "Final Cucumber tags: ${finalTags}"

                    def testStatus = sh(
                        script: """
                            mvn clean test \
                              -Dbrowser.name=${params.BROWSER} \
                              -Dframework.log.level=${params.FRAMEWORK_LOG_LEVEL} \
                              -Dlibrary.log.level=WARN \
                              -Dcucumber.filter.tags="${finalTags}"
                        """,
                        returnStatus: true
                    )

                    echo "Maven test exit code: ${testStatus}"
                    writeFile file: "${env.TEST_EXIT_CODE_FILE}", text: "${testStatus}"

                    if (testStatus != 0) {
                        echo "Some tests failed, but pipeline will continue and remain SUCCESS."
                    }
                }
            }
        }

        stage('Prepare Allure History') {
            steps {
                sh '''
                    if [ -d "${ALLURE_REPORT}/history" ]; then
                        echo "Copying previous Allure history..."
                        mkdir -p "${ALLURE_RESULTS}/history"
                        cp -r "${ALLURE_REPORT}/history/"* "${ALLURE_RESULTS}/history/" || true
                    else
                        echo "No previous Allure history found."
                    fi
                '''
            }
        }

        stage('Generate Allure Report') {
            steps {
                sh '''
                    echo "Generating Allure report..."

                    if [ -d "${ALLURE_RESULTS}" ]; then
                        allure generate "${ALLURE_RESULTS}" --clean -o "${ALLURE_REPORT}" || true
                    else
                        echo "Allure results directory not found: ${ALLURE_RESULTS}"
                    fi
                '''
            }
        }

        stage('Build Email Report') {
            steps {
                script {
                    def summaryPath = "${env.ALLURE_REPORT}/widgets/summary.json"

                    if (!fileExists(summaryPath)) {
                        writeFile file: "${env.EMAIL_REPORT_FILE}", text: """
                        <html>
                            <body>
                                <h2>Test Execution Report</h2>
                                <p>Allure summary file not found: ${summaryPath}</p>
                                <p>Build URL: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            </body>
                        </html>
                        """
                        return
                    }

                    def summary = readJSON file: summaryPath
                    def time = summary.time ?: [:]

                    def startMillis = time.start ?: 0
                    def stopMillis = time.stop ?: 0
                    def durationMillis = time.duration ?: (stopMillis - startMillis)

                    def dateFormat = new java.text.SimpleDateFormat("yyyy-MM-dd")
                    def timeFormat = new java.text.SimpleDateFormat("HH:mm:ss")

                    def executionDate = startMillis ? dateFormat.format(new Date(startMillis as long)) : "N/A"
                    def startTime = startMillis ? timeFormat.format(new Date(startMillis as long)) : "N/A"
                    def endTime = stopMillis ? timeFormat.format(new Date(stopMillis as long)) : "N/A"

                    long durationSeconds = ((durationMillis ?: 0) as long).intdiv(1000)
                    def durationText = "${durationSeconds}s"

                    /*
                     * uniqueTests stores one logical scenario only once.
                     * If the same scenario is executed multiple times because of retry,
                     * it is grouped using Allure historyId.
                     */
                    def uniqueTests = [:]

                    def testCaseFiles = sh(
                        script: "find ${env.ALLURE_REPORT}/data/test-cases -name '*.json' 2>/dev/null || true",
                        returnStdout: true
                    ).trim()

                    if (testCaseFiles) {
                        testCaseFiles.split("\\n").each { filePath ->
                            def testCase = readJSON file: filePath

                            def labels = testCase.labels ?: []
                            def suiteLabel = labels.find { it.name == 'suite' }?.value
                            def featureLabel = labels.find { it.name == 'feature' }?.value

                            def suiteName = suiteLabel ?: featureLabel ?: 'Default Suite'
                            def testName = testCase.name ?: testCase.fullName ?: filePath
                            def testKey = testCase.historyId ?: testCase.fullName ?: testName

                            def status = testCase.status ?: 'unknown'
                            long start = ((testCase.time?.start ?: 0) as long)

                            if (!uniqueTests.containsKey(testKey)) {
                                uniqueTests[testKey] = [
                                    name       : testName,
                                    suite      : suiteName,
                                    finalStatus: status,
                                    start      : start,
                                    executions : [status]
                                ]
                            } else {
                                def existing = uniqueTests[testKey]

                                existing.executions.add(status)

                                /*
                                 * Keep the latest execution as the final status.
                                 */
                                if (start >= ((existing.start ?: 0) as long)) {
                                    existing.finalStatus = status
                                    existing.start = start
                                    existing.suite = suiteName
                                    existing.name = testName
                                }

                                uniqueTests[testKey] = existing
                            }
                        }
                    }

                    def suiteStats = [:]

                    int totalTests = 0
                    int passedTests = 0
                    int failedTests = 0
                    int flakyTests = 0

                    uniqueTests.values().each { test ->
                        def suiteName = test.suite ?: 'Default Suite'
                        def finalStatus = test.finalStatus ?: 'unknown'
                        def executions = test.executions ?: []

                        if (!suiteStats.containsKey(suiteName)) {
                            suiteStats[suiteName] = [
                                total : 0,
                                passed: 0,
                                failed: 0,
                                flaky : 0
                            ]
                        }

                        boolean hasRetry = executions.size() > 1
                        boolean hasFailureBefore = executions.any { it == 'failed' || it == 'broken' }
                        boolean isFinalPassed = finalStatus == 'passed'
                        boolean isFinalFailed = finalStatus == 'failed' || finalStatus == 'broken'

                        totalTests++
                        suiteStats[suiteName].total++

                        if (isFinalPassed && hasRetry && hasFailureBefore) {
                            flakyTests++
                            suiteStats[suiteName].flaky++

                        } else if (isFinalPassed) {
                            passedTests++
                            suiteStats[suiteName].passed++

                        } else if (isFinalFailed) {
                            failedTests++
                            suiteStats[suiteName].failed++
                        }
                    }

                    def passedPercent = totalTests > 0 ? ((passedTests * 100).intdiv(totalTests)) : 0
                    def failedPercent = totalTests > 0 ? ((failedTests * 100).intdiv(totalTests)) : 0
                    def flakyPercent  = totalTests > 0 ? ((flakyTests  * 100).intdiv(totalTests)) : 0

                    def passEnd = passedPercent
                    def failEnd = passedPercent + failedPercent

                    def suitesRows = ""

                    suiteStats.keySet().sort().each { suiteName ->
                        def s = suiteStats[suiteName]

                        suitesRows += """
                            <tr>
                                <td>${suiteName}</td>
                                <td align="center">${s.total}</td>
                                <td align="center" style="color:green;"><b>${s.passed}</b></td>
                                <td align="center" style="color:red;"><b>${s.failed}</b></td>
                                <td align="center" style="color:orange;"><b>${s.flaky}</b></td>
                            </tr>
                        """
                    }

                    if (!suitesRows?.trim()) {
                        suitesRows = """
                            <tr>
                                <td colspan="5" align="center">No suite details found</td>
                            </tr>
                        """
                    }

                    def finalTags = params.TAGS?.trim()

                    if (!finalTags) {
                        finalTags = 'not @ignore'
                    } else {
                        finalTags = "(${finalTags}) and not @ignore"
                    }

                    def allureChartHtml = """
                    <h3>Allure Execution Overview</h3>

                    <table cellspacing="0" cellpadding="0" style="margin-bottom:20px;">
                        <tr>
                            <td style="padding-right:40px; text-align:center;">
                                <div style="font-size:42px; font-weight:bold; color:#000;">
                                    ${totalTests}
                                </div>
                                <div style="font-size:14px; color:#777;">
                                    test cases
                                </div>
                            </td>

                            <td>
                                <div style="
                                    width:160px;
                                    height:160px;
                                    border-radius:50%;
                                    background:conic-gradient(
                                        #97cc64 0% ${passEnd}%,
                                        #ff5a44 ${passEnd}% ${failEnd}%,
                                        #ffd666 ${failEnd}% 100%
                                    );
                                    position:relative;
                                ">
                                    <div style="
                                        position:absolute;
                                        width:105px;
                                        height:105px;
                                        border-radius:50%;
                                        background:#ffffff;
                                        top:27px;
                                        left:27px;
                                        text-align:center;
                                        line-height:105px;
                                        font-size:30px;
                                        font-weight:bold;
                                        color:#000;
                                    ">
                                        ${passedPercent}%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                    """

                    def htmlBody = """
                    <html>
                        <body style="font-family: Arial, sans-serif; color: #333;">
                            <h2>Jenkins Test Execution Report</h2>

                            <p>Hello,</p>

                            <p>
                                The automated test execution has been completed.
                                Please find below the execution summary.
                            </p>

                            ${allureChartHtml}

                            <h3>Execution Information</h3>

                            <table border="1" cellspacing="0" cellpadding="8" style="border-collapse: collapse;">
                                <tr>
                                    <td><b>Project</b></td>
                                    <td>${env.JOB_NAME}</td>
                                </tr>
                                <tr>
                                    <td><b>Build Number</b></td>
                                    <td>#${env.BUILD_NUMBER}</td>
                                </tr>
                                <tr>
                                    <td><b>Date</b></td>
                                    <td>${executionDate}</td>
                                </tr>
                                <tr>
                                    <td><b>Start Time</b></td>
                                    <td>${startTime}</td>
                                </tr>
                                <tr>
                                    <td><b>End Time</b></td>
                                    <td>${endTime}</td>
                                </tr>
                                <tr>
                                    <td><b>Execution Time</b></td>
                                    <td>${durationText}</td>
                                </tr>
                                <tr>
                                    <td><b>Browser</b></td>
                                    <td>${params.BROWSER}</td>
                                </tr>
                                <tr>
                                    <td><b>Cucumber Tags</b></td>
                                    <td>${finalTags}</td>
                                </tr>
                            </table>

                            <h3>Global Test Summary</h3>

                            <table border="1" cellspacing="0" cellpadding="8" style="border-collapse: collapse;">
                                <tr style="background-color:#f2f2f2;">
                                    <th>Total Tests</th>
                                    <th>Passed</th>
                                    <th>Failed</th>
                                    <th>Flaky</th>
                                </tr>
                                <tr>
                                    <td align="center"><b>${totalTests}</b></td>
                                    <td align="center" style="color:green;">
                                        <b>${passedTests}</b><br/>
                                        <span style="font-size:12px;">${passedPercent}%</span>
                                    </td>
                                    <td align="center" style="color:red;">
                                        <b>${failedTests}</b><br/>
                                        <span style="font-size:12px;">${failedPercent}%</span>
                                    </td>
                                    <td align="center" style="color:orange;">
                                        <b>${flakyTests}</b><br/>
                                        <span style="font-size:12px;">${flakyPercent}%</span>
                                    </td>
                                </tr>
                            </table>

                            <h3>Suites Summary</h3>

                            <table border="1" cellspacing="0" cellpadding="8" style="border-collapse: collapse;">
                                <tr style="background-color:#f2f2f2;">
                                    <th>Suite</th>
                                    <th>Total</th>
                                    <th>Passed</th>
                                    <th>Failed</th>
                                    <th>Flaky</th>
                                </tr>
                                ${suitesRows}
                            </table>

                            <h3>Links</h3>

                            <p>
                                <b>Build URL:</b>
                                <a href="${env.BUILD_URL}">${env.BUILD_URL}</a>
                            </p>

                            <p>
                                <b>Allure Report:</b>
                                <a href="${env.BUILD_URL}allure">${env.BUILD_URL}allure</a>
                            </p>

                            <p>Regards,<br/>Jenkins Automation Pipeline</p>
                        </body>
                    </html>
                    """

                    writeFile file: "${env.EMAIL_REPORT_FILE}", text: htmlBody
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Publishing reports and archiving artifacts...'

                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    junit(
                        allowEmptyResults: true,
                        skipMarkingBuildUnstable: true,
                        testResults: 'target/surefire-reports/*.xml'
                    )
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    archiveArtifacts artifacts: '''
                        target/allure-results/**,
                        allure-report/**,
                        target/logs/**,
                        target/videos/**,
                        target/screenshots/**,
                        test-exit-code.txt,
                        email-report.html
                    ''', allowEmptyArchive: true
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    allure([
                        commandline: 'Allure',
                        includeProperties: false,
                        jdk: '',
                        reportBuildPolicy: 'ALWAYS',
                        results: [[path: 'target/allure-results']]
                    ])
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    emailext(
                        subject: "Test Execution Report - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                        body: fileExists("${env.EMAIL_REPORT_FILE}")
                            ? readFile("${env.EMAIL_REPORT_FILE}")
                            : "Test execution completed. Build URL: ${env.BUILD_URL}",
                        mimeType: 'text/html',
                        to: "${params.EMAIL_RECIPIENTS}"
                    )
                }

                currentBuild.result = 'SUCCESS'
                echo 'Pipeline finished as SUCCESS.'
            }
        }

        success {
            echo 'Pipeline completed successfully.'
        }
    }
}